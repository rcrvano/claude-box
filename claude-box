#!/usr/bin/env bash
# claude-box — host-side entry point into the container. Aware of the directory it was launched from.
#   claude-box            — inside a workspace subfolder -> jump straight to that folder's session picker;
#                           at the workspace root -> full menu; outside the workspace -> temporary session
#   claude-box --build    — rebuild the image and launch
#   claude-box --no-proxy — launch claude WITHOUT the foreign proxy (host's direct egress)
#   claude-box --install  — print how to add claude-box to PATH (changes nothing)
set -euo pipefail

# caller's cwd — BEFORE switching to the repository directory
CALLER_PWD="$(pwd -P)"
# real path of the script (works via symlink and via PATH too) -> repository root
SELF="$(readlink -f "$0")"
REPO="$(dirname "$SELF")"

if [ "${1:-}" = "--install" ]; then
  cat <<EOF
Add claude-box to PATH using one of these methods:

  # symlink (needs sudo once):
  sudo ln -s "$SELF" /usr/local/bin/claude-box

  # or an alias in ~/.bashrc:
  echo 'alias claude-box="$SELF"' >> ~/.bashrc && . ~/.bashrc
EOF
  exit 0
fi

# --- PROJECT_DIR sanity check (mounted as /workspace by docker-compose) ---
# A missing/placeholder/typo'd path is NOT a harmless mistake: docker auto-creates a missing
# bind-mount source ROOT-owned, so /workspace lands in the container unwritable by node (uid 1000),
# and every write inside it fails with a bare "Permission denied". Fail loudly here instead.
PLACEHOLDER='/path/to/your/project'
PROJECT_DIR_VAL="$(grep -E '^PROJECT_DIR=.+' "$REPO/.env" 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
PROJECT_DIR_VAL="${PROJECT_DIR_VAL:-${PROJECT_DIR:-}}"
case "$PROJECT_DIR_VAL" in
  '')           die_msg="PROJECT_DIR is not set in .env" ;;
  "$PLACEHOLDER") die_msg="PROJECT_DIR is still the placeholder from .env.example" ;;
  *)            [ -d "$PROJECT_DIR_VAL" ] || die_msg="PROJECT_DIR points to a non-existent folder: $PROJECT_DIR_VAL" ;;
esac
if [ -n "${die_msg:-}" ]; then
  printf '✗ %s\n\n' "$die_msg" >&2
  printf '  Set it in %s/.env to the folder you want mounted as /workspace, e.g.:\n' "$REPO" >&2
  printf '      PROJECT_DIR=%s\n\n' "$HOME/code" >&2
  printf '  The folder must exist and be owned by your user (uid %s) — otherwise\n' "$(id -u)" >&2
  printf '  /workspace ends up root-owned and read-only inside the container.\n' >&2
  exit 1
fi

# --- web terminal (ttyd daemon): separate mode, does not interfere with normal sessions ---
case "${1:-}" in
  --web|--web-stop|--web-status)
    cd "$REPO"; mkdir -p ./home
    # We take the port for echo from .env (only compose reads it, not our shell) — otherwise
    # the output would show the hardcoded default 7681 instead of the actually configured port.
    PORT="$(grep -E '^WEB_TERMINAL_PORT=.+' .env 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
    PORT="${PORT:-${WEB_TERMINAL_PORT:-7681}}"
    # sidecar https listener (secure context: clipboard + notifications). Also from .env.
    TLS_PORT="$(grep -E '^WEB_TLS_PORT=.+' .env 2>/dev/null | tail -n1 | cut -d= -f2- || true)"
    TLS_PORT="${TLS_PORT:-${WEB_TLS_PORT:-8443}}"
    # --tunnel may go alongside --web (claude-box --web --tunnel)
    want_tunnel=0
    for a in "$@"; do [ "$a" = "--tunnel" ] && want_tunnel=1; done
    case "$1" in
      --web)
        # Always rebuild the image (layers are cached) — otherwise an old image without
        # ttyd/scripts will crash the web container. We disable the proxy at the build stage (as in
        # the main build path below): through the foreign proxy, resolving FROM/the hub fails.
        docker compose build \
          --build-arg HTTP_PROXY= --build-arg HTTPS_PROXY= \
          --build-arg http_proxy= --build-arg https_proxy= \
          --build-arg NO_PROXY='*' --build-arg no_proxy='*' web
        tunnel_env=()
        if [ "$want_tunnel" = "1" ]; then
          # fail-closed: a public shell without a password is not allowed. We read .env on the host
          # to give an instant message in this terminal (the container also has
          # a protective check in web-serve.sh).
          pw="$(grep -E '^WEB_TERMINAL_PASSWORD=.+' .env 2>/dev/null | tail -n1 | cut -d= -f2-)"
          if [ -z "$pw" ]; then
            echo "✗ Tunnel not started: WEB_TERMINAL_PASSWORD is not set in .env (a public shell without a password is not allowed)."
            echo "  Bringing up the web terminal locally, without public access."
          else
            tunnel_env=(WEB_TUNNEL=1)
          fi
        fi
        env "${tunnel_env[@]}" docker compose up -d web
        echo "Web terminal up: http://localhost:${PORT}"
        echo "Web terminal with notification up: https://localhost:${TLS_PORT}"
        if [ -n "${tunnel_env[*]}" ]; then
          if grep -qE '^NGROK_AUTHTOKEN=.+' .env 2>/dev/null; then
            echo "Bringing up a public tunnel (ngrok)…"
          else
            echo "Bringing up a public tunnel (cloudflared, no token)…"
          fi
          # The container writes the URL to ./home/.claude/web-tunnel-url (bind mount). But cloudflared
          # buffers stdout to its log file and flushes the URL in a delayed batch — so, besides
          # web-tunnel-url, we grep cloudflared's log directly (also visible via the bind mount),
          # to avoid depending on a race with the loop inside the container. Wait window — ~60s.
          urlfile="./home/.claude/web-tunnel-url"
          cflog="./home/.claude/cloudflared.log"
          url=""
          for _ in $(seq 1 120); do
            [ -s "$urlfile" ] && { url="$(head -n1 "$urlfile")"; break; }
            u="$(grep -o 'https://[a-z0-9-]*\.trycloudflare\.com' "$cflog" 2>/dev/null | head -n1 || true)"
            [ -n "$u" ] && { url="$u"; break; }
            sleep 0.5
          done
          if [ -n "$url" ]; then
            echo "🌍 Public access: ${url}  (login: claude)"
          else
            echo "⚠ Tunnel not visible yet. Check: docker compose logs web"
          fi
        fi
        ;;
      --web-stop)
        docker compose rm -sf web
        echo "Web terminal stopped."
        ;;
      --web-status)
        cid="$(docker ps -q --filter label=claude-box.role=web | head -n1)"
        if [ -z "$cid" ]; then
          echo "Web terminal not running."
        else
          echo "Web terminal running: http://localhost:${PORT}"
          url="$(head -n1 ./home/.claude/web-tunnel-url 2>/dev/null || true)"
          [ -n "$url" ] && echo "Public tunnel: ${url}"
          echo "Active tmux sessions:"
          docker exec "$cid" tmux list-sessions 2>/dev/null || echo "  (no active sessions or tmux has not started yet)"
        fi
        ;;
    esac
    exit 0
    ;;
esac

cd "$REPO"
mkdir -p ./home

force_build=0
no_proxy_run=0
for a in "$@"; do
  case "$a" in
    --build)    force_build=1 ;;
    --no-proxy) no_proxy_run=1 ;;   # claude without the foreign proxy (host's direct egress)
  esac
done

# --- target by cwd relative to the workspace root ---
# We take the root from the script's own location ($REPO/..), and NOT from the PROJECT_DIR line
# in .env: the live path (pwd -P) and the .env string may resolve differently because of
# Docker Desktop bind mounts (/mnt/c/... -> /mnt/wsl/docker-desktop-bind-mounts/...),
# and a strict comparison then wrongly drops into --scratch. $REPO is already canonicalized above
# (SELF=readlink -f "$0"), so it resolves the same way as the live here.
# ${PROJECT_DIR} from .env is mounted into the container (see docker-compose.yml) — we don't touch that.
mode_arg=()                                   # what to pass to claude-launch (entrypoint)
proj_real="$(readlink -f "$REPO/.." 2>/dev/null || echo "$REPO/..")"
if [ -n "$proj_real" ] && [ -d "$proj_real" ]; then
  here="$(readlink -f "$CALLER_PWD" 2>/dev/null || echo "$CALLER_PWD")"
  if [ "$here" = "$proj_real" ]; then
    :                                         # workspace root -> full menu (no argument)
  elif [ "$here" = "$REPO" ]; then
    :                                         # launched from the claude-box directory itself -> up to the workspace root -> full menu (like claude-box.bat)
  elif [ "${here#"$proj_real"/}" != "$here" ]; then
    mode_arg=("/workspace/${here#"$proj_real"/}")   # subfolder -> session picker for this folder
  else
    mode_arg=(--scratch "no access to $here (outside workspace $proj_real) — temporary session")
  fi
else
  mode_arg=(--scratch "workspace root not found ($REPO/..) — temporary session")
fi

# Container already running? -> attach (another session alongside), except for an explicit --build
if [ "$force_build" -eq 1 ]; then
  mapfile -t running < <(docker ps -q --filter label=claude-box.role=session 2>/dev/null || true)
  if [ ${#running[@]} -gt 0 ]; then
    docker stop "${running[@]}"
  fi
fi

# Build the image on --build or if it does not exist yet
if [ "$force_build" -eq 1 ] || ! docker image inspect claude-box >/dev/null 2>&1; then
  # Build directly, bypassing the proxy. IMPORTANT: docker compose reads .env at the build stage too,
  # picking up HTTPS_PROXY from there (it is needed only for Claude→Anthropic INSIDE the container at
  # the run stage). Through the foreign proxy, BuildKit resolves FROM node:22-slim -> the request
  # for the Docker Hub anon token goes through the proxy -> 401 Unauthorized; and GitHub releases time out.
  # --build-arg covers only the RUN steps, NOT image resolution. So we disable the proxy in
  # the ENVIRONMENT of the build command (shell env overrides .env per Compose rules); we don't touch .env for run.
#  HTTP_PROXY= HTTPS_PROXY= http_proxy= https_proxy= NO_PROXY='*' no_proxy='*' \
  # One target is enough: the web service shares the same Dockerfile and the same claude-box tag.
  docker compose build \
    --build-arg HTTP_PROXY= --build-arg HTTPS_PROXY= \
    --build-arg http_proxy= --build-arg https_proxy= \
    --build-arg NO_PROXY='*' --build-arg no_proxy='*' claude
fi

# --no-proxy: disable the proxy variables ONLY for this run (they override env_file from .env);
# useful when the host has direct access to api.anthropic.com and the proxy is unneeded/down.
run_env=()
if [ "$no_proxy_run" -eq 1 ]; then
  run_env=(-e HTTP_PROXY= -e HTTPS_PROXY= -e http_proxy= -e https_proxy= -e ALL_PROXY= -e all_proxy=)
fi

exec docker compose run --rm "${run_env[@]}" --label claude-box.role=session claude "${mode_arg[@]}"
