FROM claude-box
# The base image ends with USER node — system-wide installation needs root.
USER root
# code-server (VS Code in the browser). The official script installs the .deb system-wide:
# /usr/bin/code-server.
RUN curl -fsSL https://code-server.dev/install.sh | sh \
 && rm -rf /tmp/*
COPY scripts/vscode-serve.sh /usr/local/bin/claude-vscode-serve
RUN chmod +x /usr/local/bin/claude-vscode-serve
USER node
ENTRYPOINT ["/usr/local/bin/claude-vscode-serve"]
