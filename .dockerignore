# don't send to the build context (and don't expose secrets to the daemon)
home/
home-*/
.claude/
.claude.json
.env*
*.sh
scripts/*.sh
# the shell pieces that run inside the image (host-only scripts like certs-fix.sh stay excluded)
!scripts/web-menu.sh
!scripts/notify.sh
!scripts/web-entry.sh
!scripts/claude-default.sh
docker-compose*.yml
# site deploy leftovers (wrangler tmp cache) — nothing in the image needs them
.wrangler/
